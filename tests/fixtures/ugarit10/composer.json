{
    "name": "ugarit/ugarit",
    "type": "project",
    "description": "The skeleton application for the Ugarit framework.",
    "keywords": [
        "ugarit",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.2",
        "ugarit/framework": "^1.00.00",
        "ugarit/sanctum": "^1.00.00",
        "ugarit/tinker": "^1.00.00"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "ugarit/pint": "^1.00.00",
        "ugarit/sail": "^1.00.00",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/ugarit-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Heritage\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php scribe package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php scribe vendor:publish --tag=ugarit-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php scribe key:generate --ansi"
        ]
    },
    "extra": {
        "ugarit": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "version": "1.00.00"
}
