{
    "name": "ugarit/installer",
    "description": "Ugarit application installer.",
    "keywords": [
        "ugarit"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "heritage/filesystem": "^1.00.00",
        "heritage/support": "^1.00.00",
        "ugarit/prompts": "^1.00.00",
        "ugarit/agent-detector": "^1.00.00",
        "symfony/console": "^6.2|^7.0|^8.0",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/process": "^6.2|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.4"
    },
    "bin": [
        "bin/ugarit"
    ],
    "autoload": {
        "psr-4": {
            "Ugarit\\Installer\\Console\\": "src/",
            "Heritage\\": "src/Heritage/"
        },
        "files": [
            "src/Heritage/Filesystem/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Ugarit\\Installer\\Console\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
